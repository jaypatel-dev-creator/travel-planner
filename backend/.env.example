# MongoDB (Atlas connection string or mongodb://localhost:27017)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=travel_planner

# Google Places API (New) key - server-side only, never sent to the browser
GOOGLE_PLACES_API_KEY=your_places_api_key_here

# Gemini key for the AI assistant
GOOGLE_API_KEY=your_gemini_api_key_here

# App
APP_ENV=development
FRONTEND_URL=http://localhost:5173

# Document uploads
MAX_UPLOAD_MB=5
