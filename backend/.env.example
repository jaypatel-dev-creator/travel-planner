# MongoDB (Atlas connection string or mongodb://localhost:27017)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=travel_planner

# Google Places API (New) key - OPTIONAL, server-side only.
# Leave empty to use OpenStreetMap place search (no key needed).
GOOGLE_PLACES_API_KEY=

# Gemini key for the AI assistant - OPTIONAL.
# Without it the assistant returns a "not configured" message; everything else works.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# App
APP_ENV=development
FRONTEND_URL=http://localhost:5173

# Document uploads
MAX_UPLOAD_MB=5